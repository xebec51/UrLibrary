generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  LIBRARIAN
  MEMBER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CopyStatus {
  AVAILABLE
  BORROWED
  RESERVED
  MAINTENANCE
  LOST
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
  LOST
}

enum ReservationStatus {
  PENDING
  READY_FOR_PICKUP
  FULFILLED
  CANCELLED
  EXPIRED
}

enum FineStatus {
  UNPAID
  PAID
  WAIVED
}

enum NotificationType {
  DUE_SOON
  OVERDUE
  RESERVATION_READY
  FINE_CREATED
  SYSTEM
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  BORROW
  RETURN
  RESERVE
  CANCEL_RESERVATION
  MARK_READY
  PAY_FINE
  WAIVE_FINE
  EXPORT
}

model User {
  id                String          @id @default(cuid())
  name              String
  email             String          @unique
  password          String
  role              UserRole        @default(MEMBER)
  status            UserStatus      @default(ACTIVE)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  profile           LibraryProfile?
  favorites         Favorite[]
  readingLists      ReadingList[]
  reviews           Review[]
  loans             Loan[]          @relation("BorrowerLoans")
  createdLoans      Loan[]          @relation("LoanCreator")
  returnedLoans     Loan[]          @relation("LoanReturner")
  reservations      Reservation[]
  fines             Fine[]
  notifications     Notification[]
  auditLogs         AuditLog[]

  @@index([role])
  @@index([status])
}

model LibraryProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  memberCode String   @unique
  phone      String?
  address    String?
  joinedAt   DateTime @default(now())
  notes      String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Book {
  id              String            @id @default(cuid())
  title           String
  slug            String            @unique
  isbn            String?           @unique
  description     String
  coverUrl        String?
  publicationYear Int?
  language        String            @default("English")
  pageCount       Int?
  edition         String?
  locationShelf   String?
  isPublished     Boolean           @default(true)
  publisherId     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  publisher       Publisher?        @relation(fields: [publisherId], references: [id])
  copies          BookCopy[]
  authors         BookAuthor[]
  categories      BookCategory[]
  tags            BookTag[]
  favorites       Favorite[]
  readingItems    ReadingListItem[]
  reviews         Review[]
  reservations    Reservation[]

  @@index([isPublished, createdAt])
  @@index([title])
  @@index([publisherId])
}

model BookCopy {
  id              String     @id @default(cuid())
  bookId          String
  copyCode        String     @unique
  barcode         String?    @unique
  status          CopyStatus @default(AVAILABLE)
  acquisitionDate DateTime?
  conditionNote   String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  book            Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  loans           Loan[]

  @@index([bookId, status])
}

model Author {
  id    String       @id @default(cuid())
  name  String
  slug  String       @unique
  bio   String?
  books BookAuthor[]
}

model Publisher {
  id      String @id @default(cuid())
  name    String
  slug    String @unique
  website String?
  books   Book[]
}

model Category {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  books       BookCategory[]
}

model Tag {
  id    String    @id @default(cuid())
  name  String
  slug  String    @unique
  books BookTag[]
}

model BookAuthor {
  id       String @id @default(cuid())
  bookId   String
  authorId String
  book     Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author   Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([bookId, authorId])
  @@index([authorId])
}

model BookCategory {
  id         String   @id @default(cuid())
  bookId     String
  categoryId String
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([bookId, categoryId])
  @@index([categoryId])
}

model BookTag {
  id     String @id @default(cuid())
  bookId String
  tagId  String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([bookId, tagId])
  @@index([tagId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([bookId])
}

model ReadingList {
  id          String            @id @default(cuid())
  userId      String
  title       String
  description String?
  isPublic    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       ReadingListItem[]

  @@index([userId, updatedAt])
}

model ReadingListItem {
  id            String      @id @default(cuid())
  readingListId String
  bookId        String
  notes         String?
  order         Int         @default(0)
  createdAt     DateTime    @default(now())
  readingList   ReadingList @relation(fields: [readingListId], references: [id], onDelete: Cascade)
  book          Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([readingListId, bookId])
  @@index([bookId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  rating    Int
  title     String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([bookId, rating])
}

model Loan {
  id           String     @id @default(cuid())
  userId       String
  bookCopyId   String
  borrowedAt   DateTime   @default(now())
  dueAt        DateTime
  returnedAt   DateTime?
  status       LoanStatus @default(ACTIVE)
  renewalCount Int        @default(0)
  notes        String?
  createdById  String
  returnedById String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation("BorrowerLoans", fields: [userId], references: [id])
  bookCopy     BookCopy   @relation(fields: [bookCopyId], references: [id])
  createdBy    User       @relation("LoanCreator", fields: [createdById], references: [id])
  returnedBy   User?      @relation("LoanReturner", fields: [returnedById], references: [id])
  fine         Fine?

  @@index([userId, status])
  @@index([bookCopyId, status])
  @@index([dueAt, status])
}

model Reservation {
  id            String            @id @default(cuid())
  userId        String
  bookId        String
  status        ReservationStatus @default(PENDING)
  queuePosition Int
  reservedAt    DateTime          @default(now())
  readyAt       DateTime?
  expiresAt     DateTime?
  fulfilledAt   DateTime?
  cancelledAt   DateTime?
  notes         String?
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  book          Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, status, queuePosition])
  @@index([userId, status])
}

model Fine {
  id        String     @id @default(cuid())
  userId    String
  loanId    String?    @unique
  amount    Decimal    @db.Decimal(10, 2)
  status    FineStatus @default(UNPAID)
  reason    String
  paidAt    DateTime?
  waivedAt  DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  loan      Loan?      @relation(fields: [loanId], references: [id])

  @@index([userId, status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model AuditLog {
  id           String      @id @default(cuid())
  userId       String?
  action       AuditAction
  module       String
  description  String
  metadataJson Json?
  createdAt    DateTime    @default(now())
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([module, createdAt])
  @@index([userId, createdAt])
}

model LibrarySetting {
  id                    String   @id @default(cuid())
  maxActiveLoans        Int      @default(5)
  loanDurationDays      Int      @default(14)
  maxRenewals           Int      @default(1)
  dailyFineAmount       Decimal  @default(2000) @db.Decimal(10, 2)
  fineLimit             Decimal  @default(50000) @db.Decimal(10, 2)
  reservationExpiryDays Int      @default(3)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
