# PostgreSQL or Neon connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/urlibrary_nexus?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-local-development-secret"
